# Facebook / Meta App Configuration
# Get these values from https://developers.facebook.com/apps/
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here
APP_SECRET=your_app_secret_here
APP_ID=your_app_id_here
VERIFY_TOKEN=your_custom_verify_token_here

# WhatsApp Phone Number ID (from Meta Business > WhatsApp > API Setup)
PHONE_ID=your_phone_number_id_here

# Server
PORT=8080
